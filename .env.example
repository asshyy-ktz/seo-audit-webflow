# Webflow OAuth App credentials (from your app's dashboard at developers.webflow.com)
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/oauth/callback

# Comma-separated scopes requested during install
WEBFLOW_SCOPES=sites:read,pages:read,cms:read,cms:write

# Public URL this server is reachable at (used to register webhooks)
APP_PUBLIC_URL=http://localhost:3000

# Conceptual cron: run a full audit for every installed site every N hours (0 = disabled)
AUDIT_INTERVAL_HOURS=0

DATABASE_PATH=./db/seo-audit.sqlite

PORT=3000
